{
  "name": "msimcity",
  "private": true,
  "version": "0.1.0",
  "license": "AGPL-3.0-or-later",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run buildings:compile && concurrently -n server,client -c blue,green \"npm run dev -w @msimcity/server\" \"npm run dev -w @msimcity/client\"",
    "dev:server": "npm run dev -w @msimcity/server",
    "dev:client": "npm run dev -w @msimcity/client",
    "build": "npm run buildings:compile && npm run build -w @msimcity/client",
    "build:local": "npm run buildings:compile && npm run build:local -w @msimcity/client",
    "start": "npm run start -w @msimcity/server",
    "typecheck": "tsc -p packages/shared && tsc -p packages/shared/scripts && tsc -p packages/server && tsc -p packages/client && npm run -s local:check",
    "buildings:compile": "tsx packages/shared/scripts/compile-buildings.ts",
    "buildings:check": "tsx packages/shared/scripts/check-buildings.ts",
    "landmarks:check": "tsx packages/shared/scripts/check-landmarks.ts",
    "demo:check": "tsx packages/server/src/demo/check.ts",
    "warm:check": "tsx packages/server/src/loadtest/warm.ts",
    "local:check": "tsx packages/server/src/local/check.ts",
    "history:check": "tsx packages/server/src/history-check.ts",
    "parcels:check": "tsx packages/server/src/parcels-check.ts",
    "finance:check": "tsx packages/server/src/finance-check.ts",
    "perf:check": "tsx packages/server/src/loadtest/perf-check.ts",
    "crossing:check": "tsx packages/server/src/crossing-check.ts",
    "auth:check": "tsx packages/server/src/auth-check.ts"
  },
  "devDependencies": {
    "concurrently": "^9.0.1",
    "typescript": "^5.6.3"
  }
}
